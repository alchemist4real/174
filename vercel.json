{
  "cleanUrls": true,
  "routes": [
    { "src": "/api/mcp/token", "dest": "/api/token" },
    { "src": "/api/mcp/authorize", "dest": "/api/authorize" },
    { "src": "/api/mcp/register", "dest": "/api/register" },
    { "src": "/api/upload", "dest": "/api/mcp?upload=true" },
    { "src": "/api/mcp", "dest": "/api/mcp" },
    { "src": "/.well-known/oauth-authorization-server", "dest": "/api/authorize" },
    { "src": "/.well-known/openid-configuration", "dest": "/api/authorize" },
    { "src": "/.well-known/oauth-protected-resource(.*)", "dest": "/api/mcp" },
    { "src": "/register", "dest": "/api/register" },
    { "src": "/authorize", "dest": "/api/authorize" },
    { "src": "/token", "dest": "/api/token" },
    { "src": "/api/env", "dest": "/api/env" },
    { "src": "/api/config", "dest": "/api/env?type=config" },
    { "src": "/api/guest-cleanup", "dest": "/api/admin?action=cleanup_guests" },
    { "src": "/api/review-tools", "dest": "/api/admin" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/docs", "dest": "/docs.html" },
    { "src": "/live", "dest": "/live.html" },
    { "handle": "filesystem" }
  ]
}
