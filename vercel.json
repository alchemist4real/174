{
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/mcp", "dest": "/api/mcp.js" },
    { "src": "/.well-known/oauth-authorization-server", "dest": "/api/oauth-authorization-server.js" },
    { "src": "/.well-known/oauth-protected-resource", "dest": "/api/oauth-protected-resource.js" },
    { "src": "/register", "dest": "/api/register.js" },
    { "src": "/authorize", "dest": "/api/authorize.js" },
    { "src": "/token", "dest": "/api/token.js" }
  ]
}
