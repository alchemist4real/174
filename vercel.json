{
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/mcp", "destination": "/api/mcp.js" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-authorization-server.js" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource.js" },
    { "source": "/register", "destination": "/api/register.js" },
    { "source": "/authorize", "destination": "/api/authorize.js" },
    { "source": "/token", "destination": "/api/token.js" }
  ]
}
